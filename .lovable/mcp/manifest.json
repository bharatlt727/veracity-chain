{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fchgmxwropqytaexiupx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "secure-case-nexus",
      "version": "0.1.0",
      "title": "Secure Case Nexus"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in officer's profile, clearance level and roles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_cases",
        "title": "List cases",
        "description": "List investigation cases visible to the signed-in officer at their clearance level.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Filter by case title or case number."
            },
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "UNDER_REVIEW",
                "FROZEN",
                "CLOSED",
                "ARCHIVED"
              ],
              "description": "Filter by case status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_case",
        "title": "Get case detail",
        "description": "Fetch one case with its evidence items and investigation timeline, by case number or case id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "case_number": {
              "type": "string",
              "minLength": 1,
              "description": "e.g. CASE-2026-001"
            },
            "case_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_evidence",
        "title": "List evidence",
        "description": "List evidence items visible to the signed-in officer, with SHA-256 fingerprint and integrity status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string",
              "format": "uuid",
              "description": "Restrict to one case."
            },
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Filter by evidence title or number."
            },
            "only_compromised": {
              "type": "boolean",
              "description": "Return only items whose integrity check has failed."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_custody_events",
        "title": "List chain-of-custody events",
        "description": "Read the append-only chain-of-custody trail for evidence the signed-in officer may access.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string",
              "format": "uuid"
            },
            "evidence_id": {
              "type": "string",
              "format": "uuid"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
